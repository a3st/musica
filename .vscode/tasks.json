{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: fetch dependencies",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "build.py",
        "--deps-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: test",
      "type": "process",
      "command": "python3",
      "args": [
        "build.py",
        "test",
        "--summary",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "python"
      }
    },
    {
      "label": "Backend: build Debug",
      "type": "process",
      "command": "python3",
      "args": [
        "build.py",
        "-Doptimize=Debug",
        "--prefix",
        "zig-out/debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "python"
      }
    },
    {
      "label": "Backend: build",
      "type": "shell",
      "command": "python3",
      "args": [
        "build.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "python"
      }
    },
    {
      "label": "Backend: build ReleaseSafe",
      "type": "shell",
      "command": "python3",
      "args": [
        "build.py",
        "-Doptimize=ReleaseSafe"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "python"
      }
    },
    {
      "label": "Backend: run",
      "type": "shell",
      "command": "python3",
      "args": [
        "build.py",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "panel": "dedicated",
        "group": "musica-dev",
        "reveal": "always"
      },
      "windows": {
        "command": "python"
      }
    },
    {
      "label": "Frontend app: install",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "ci"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend-app"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Frontend app: build",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend-app"
      },
      "group": "build",
      "problemMatcher": "$tsc",
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Frontend app: run",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend-app"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "panel": "dedicated",
        "group": "musica-dev",
        "reveal": "always"
      }
    },
    {
      "label": "Frontend admin: install",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "ci"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend-admin"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Frontend admin: build",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend-admin"
      },
      "group": "build",
      "problemMatcher": "$tsc",
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Frontend admin: run",
      "type": "shell",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend-admin"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "panel": "dedicated",
        "group": "musica-dev",
        "reveal": "always"
      }
    },
    {
      "label": "Build: all",
      "dependsOn": [
        "Backend: build",
        "Frontend app: build",
        "Frontend admin: build"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run: all",
      "dependsOn": [
        "Backend: run",
        "Frontend app: run",
        "Frontend admin: run"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
