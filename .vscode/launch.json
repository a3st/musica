{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: debug (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/backend/zig-out/debug/bin/musica-backend.exe",
      "cwd": "${workspaceFolder}/backend",
      "args": [],
