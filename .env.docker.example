# Musica 0.4.1: docker-compose.yml.
# Скопируйте в .env и передайте через --env-file.
# Секреты замените своими значениями; опциональные поля можно не задавать.

# Nginx принимает HTTP от внешнего HTTPS reverse proxy на этом же сервере.
# Внешний proxy должен сохранять Host и проксировать весь сайт, включая /profile/.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
AUTH_COOKIE_SECURE=true
# Для локальной проверки по HTTP: AUTH_COOKIE_SECURE=false.

# PostgreSQL: порты не публикуются, DB_HOST/DB_PORT задаёт Compose.
DB_NAME=musica
DB_USER=musica
DB_PASSWORD=replace-with-a-long-database-password
# Для подключения с хоста раскомментируйте DB_PORT и ports у postgres в Compose.
# DB_PORT=5432

# MinIO: API и console доступны только внутри Docker-сети.
S3_ACCESS_KEY_ID=musica-storage
S3_SECRET_ACCESS_KEY=replace-with-a-long-storage-password
S3_REGION=us-east-1
S3_BUCKET=media
# Для доступа с хоста раскомментируйте нужные переменные и ports у minio в Compose.
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# Самостоятельная регистрация выключена по умолчанию.
# REGISTRATION_ENABLED=false

# Стартовый администратор: задайте обе переменные перед первым запуском backend.
# После создания учётки их можно убрать. Пароль: от 12 до 1024 байт.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password

# Лимиты загрузки и хранения (backend проверяет размер; nginx допускает до 512 МиБ).
# MAX_UPLOAD_BYTES=67108864
# SHARED_TRACK_RETENTION_SECONDS=604800

# Независимые интеграции и общий worker скачивания.
# WEB_INT_ENABLED=true
# SPOTIFY_INT_ENABLED=true
# SPOTIFY_WORKER_ENABLED=true
# SPOTIFY_TIMEOUT_SECONDS=900

# Обработка метаданных и подготовка HLS.
# TRACK_METADATA_WORKER_ENABLED=true
# TRACK_METADATA_TIMEOUT_SECONDS=120
# HLS_WORKER_ENABLED=true
# HLS_TIMEOUT_SECONDS=900
