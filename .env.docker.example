# Скопируйте в .env в корне репозитория и замените значения паролей.
DB_NAME=musica
DB_USER=musica
DB_PASSWORD=replace-me

# В этом Compose backend использует те же ключи, что и MinIO root user.
# MinIO: access key минимум 3 символа, secret key минимум 8 символов.
S3_ACCESS_KEY_ID=musica-local
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=us-east-1
S3_BUCKET=media
MAX_UPLOAD_BYTES=67108864

# Общие загрузки Spotify/Web и подготовка HLS.
SPOTIFY_WORKER_ENABLED=true
SPOTIFY_TIMEOUT_SECONDS=900
HLS_WORKER_ENABLED=true
HLS_TIMEOUT_SECONDS=900

# Для HTTPS включите Secure-cookie. Публичная регистрация по умолчанию закрыта.
AUTH_COOKIE_SECURE=false
REGISTRATION_ENABLED=false

# Необязательно: заполните обе переменные для создания первого администратора.
# Если обе пустые, создание администратора отключено. Пароль — минимум 12 байт.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Срок хранения общих треков без пользовательских привязок, в секундах.
SHARED_TRACK_RETENTION_SECONDS=604800

# Опубликованные порты на localhost.
DB_PORT=5432
BACKEND_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
