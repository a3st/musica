# Скопируйте в .env в корне репозитория и замените значения паролей.
PGDATABASE=musica
PGUSER=musica
PGPASSWORD=12345678

# В этом Compose backend использует те же ключи, что и MinIO root user.
# MinIO: access key минимум 3 символа, secret key минимум 8 символов.
S3_ACCESS_KEY_ID=musica-local
S3_SECRET_ACCESS_KEY=12345678
S3_REGION=us-east-1
S3_BUCKET=uploads
MAX_UPLOAD_BYTES=67108864

BACKEND_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
