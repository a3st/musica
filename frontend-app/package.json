{
  "name": "@musica/frontend-app",
  "version": "0.4.3",
  "author": "Dmitriy Lukovenko",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "test:auth-ui": "node tests/e2e/auth.mjs",
    "test:profile-ui": "node tests/e2e/profile.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node tests/e2e/ui.mjs",
    "test:spotify": "node tests/unit/spotify.mjs",
    "test:web": "node tests/unit/web-search.mjs",
    "test:web-ui": "node tests/e2e/web-search.mjs",
    "test:pwa": "node tests/e2e/pwa.mjs",
    "test:proxy": "node tests/integration/proxy.mjs",
    "format": "prettier --write src vite.config.ts svelte.config.js",
    "format:check": "prettier --check src vite.config.ts svelte.config.js",
    "test:player": "node tests/unit/player.mjs",
    "test:audio": "node tests/unit/audio-settings.mjs",
    "test:i18n": "node tests/unit/i18n.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "playwright": "1.58.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3"
  },
  "dependencies": {
    "hls.js": "1.7.3"
  }
