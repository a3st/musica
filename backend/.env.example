# Пример переменных окружения. Файл .env автоматически не загружается.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=musica
PGUSER=musica
PGPASSWORD=replace-me

# S3 API MinIO (не порт web console). Создайте бакет uploads вручную.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
MAX_UPLOAD_BYTES=67108864
