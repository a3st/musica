# Пример переменных окружения. Файл .env автоматически не загружается.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080

# PostgreSQL. Миграции выполняются вручную.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=musica
DB_USER=musica
DB_PASSWORD=replace-me

# S3 API MinIO (не порт web console). Создайте бакет uploads вручную.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Лимит тела запроса и загрузки: 64 МиБ, допустимо до 512 МиБ.
MAX_UPLOAD_BYTES=67108864

# Исполняемые файлы, а не каталоги. FFprobe должен находиться рядом с FFmpeg.
# Для локального запуска установите FFmpeg, yt-dlp и Node.js 22+.
# В Docker-образе эти инструменты уже установлены.
FFMPEG_PATH=ffmpeg
# Исполняемый файл FFprobe: имя из PATH или полный путь.
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# Интеграции; Spotify зависит от Web. Если Web выключен, Spotify отключается с warning.
WEB_INT_ENABLED=true
SPOTIFY_INT_ENABLED=true

# Worker фичи imports; работает только при WEB_INT_ENABLED=true и SPOTIFY_INT_ENABLED=true.
# Имена переменных SPOTIFY_* сохраняются для совместимости.
SPOTIFY_WORKER_ENABLED=true
# Общий таймаут скачивания в секундах: от 1 до 3600.
SPOTIFY_TIMEOUT_SECONDS=900
# Без явного пути используется TEMP, затем /tmp/musica-imports.
# IMPORTS_TMP_DIR=/tmp/musica-imports

# Подготовка HLS; таймаут в секундах: от 1 до 3600.
HLS_WORKER_ENABLED=true
HLS_TIMEOUT_SECONDS=900

# Извлечение длительности и artwork независимо от HLS; таймаут от 1 до 3600 секунд.
TRACK_METADATA_WORKER_ENABLED=true
TRACK_METADATA_TIMEOUT_SECONDS=120
# TRACK_METADATA_TMP_DIR=/tmp/musica-metadata
# Без явного пути используется TEMP, затем /tmp/musica-hls.
# HLS_TMP_DIR=/tmp/musica-hls

# Включите Secure для cookie при работе через HTTPS.
AUTH_COOKIE_SECURE=false
# Публичная регистрация отключена; пользователей может создавать администратор.
REGISTRATION_ENABLED=false

# Необязательно: создаёт стартового администратора, если в БД ещё нет администратора.
# Задайте обе переменные вместе. Пароль: от 12 до 1024 байт.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# Хранение общих треков без пользовательских привязок: 7 дней, в секундах.
SHARED_TRACK_RETENTION_SECONDS=604800
