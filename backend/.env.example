# Пример окружения backend. Файл .env автоматически не загружается.
# Обязательные секреты указаны без комментария; замените значения replace-me.
# Опциональные настройки закомментированы и показывают значения по умолчанию.

# HTTP_HOST=127.0.0.1
# HTTP_PORT=8080

DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=musica
# DB_USER=musica

S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=media

# AUTH_COOKIE_SECURE=false
# REGISTRATION_ENABLED=false

# Стартовый администратор: создаётся, если в БД ещё нет администратора.
# По умолчанию создание отключено. Задайте обе переменные вместе.
# Пароль: от 12 до 1024 байт.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# Загрузка и хранение треков.
# Лимит тела запроса и файла: 64 МиБ, допустимо до 512 МиБ.
# MAX_UPLOAD_BYTES=67108864

# Общие треки без пользовательских привязок хранятся 7 дней (в секундах).
# SHARED_TRACK_RETENTION_SECONDS=604800

# Внешние инструменты: имя из PATH или полный путь к исполняемому файлу.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# Proxy только для скачивания yt-dlp; необязательно, HTTP/HTTPS или SOCKS5.
# YTDLP_PROXY=http://proxy.example.com:3128

# IMPORTS_TMP_DIR=/tmp/musica-imports

# TRACK_METADATA_WORKER_ENABLED=true
# TRACK_METADATA_TMP_DIR=/tmp/musica-metadata
# TRACK_METADATA_TIMEOUT_SECONDS=120

# HLS_WORKER_ENABLED=true
# HLS_TMP_DIR=/tmp/musica-hls
# HLS_TIMEOUT_SECONDS=900

# Независимые интеграции. Imports работает, если включена хотя бы одна.
# WEB_INT_ENABLED=true

# SPOTIFY_INT_ENABLED=true
# SPOTIFY_WORKER_ENABLED=true
# SPOTIFY_TIMEOUT_SECONDS=900
