# Пример переменных окружения. Файл .env автоматически не загружается.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=musica
PGUSER=musica
PGPASSWORD=replace-me

# S3 API MinIO (не порт web console). Создайте бакет uploads вручную.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
MAX_UPLOAD_BYTES=67108864

# HLS: FFmpeg must be installed locally; Docker image includes it.
FFMPEG_PATH=ffmpeg
# yt-dlp executable; Node.js 22+ is used for YouTube JavaScript challenges.
YTDLP_PATH=yt-dlp
SPOTIFY_WORKER_ENABLED=true
SPOTIFY_TIMEOUT_SECONDS=900
# SPOTIFY_TMP_DIR=/tmp/musica-spotify
HLS_WORKER_ENABLED=true
HLS_TIMEOUT_SECONDS=900
AUTH_COOKIE_SECURE=false
# HLS_TMP_DIR=/tmp/musica-hls
